# Application
APP_ENV=development
APP_NAME=agente-citas-backend
APP_DEBUG=true
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Database
DATABASE_URL=postgresql+asyncpg://agente:agente_dev@localhost:5432/agente_citas

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=60

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL_REASONING=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=500
ANTHROPIC_TEMPERATURE=0.3

# OpenAI (Whisper for audio transcription)
OPENAI_API_KEY=sk-xxxxx
OPENAI_WHISPER_MODEL=whisper-1

# Voyage AI (embeddings for RAG)
VOYAGE_API_KEY=pa-xxxxx
VOYAGE_EMBEDDING_MODEL=voyage-multilingual-2

# WhatsApp Cloud API (Meta)
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Meta App — Embedded Signup OAuth (para que los clientes conecten su WhatsApp sin fricción)
# Crear en https://developers.facebook.com → Tu App → Configuración básica
META_APP_ID=
META_APP_SECRET=
# Verify token del webhook de Messenger e Instagram (/webhooks/meta).
# Lo inventás vos y lo pegás igual en Meta → Messenger → Webhooks.
# Si lo dejás vacío se reutiliza WHATSAPP_VERIFY_TOKEN.
META_VERIFY_TOKEN=
#EAAWZCvsnuQoUBSMSycw1Lsm10WEEqDJZA5jSb4gewBHlbUyKB3qX9FHqG4ONmjoxpSwQe92LdBwvxaelZARiDchtRh6ZCvHzO59sYpCZCGtpoZBE3iLE4KRHkZA5yg6HCNhZBznPXCkAAxVmw6ZCYZBp2AxFHLSZBm2NKCpZBH9Ef0sABjz9ewbwsADZCljmFzmXBd5pugKUZD
#EAAWZCvsnuQoUBSM1GKMjuCH6IiN46wfR9uKC8RJjLPUny24FrjxZCZA8kGvBZBkn6khBkF4qypUUkOZBHbsD19x1gNrp46zgTMmg9U8IFJLg808uR40tdVO3HkZCZCpf88FeLkezqG4KyXhDJF8cdtItK3qqRqrbSmaO7fzxl5Anv18vHYdmFCZCteUAXeAfUZBSyrVQZD
#EAAWZCvsnuQoUBSA8ZCbWKdyMV3OLRjK9n3C2Utu8UrWLJqz5URyxshjE4gbDPsfLiKAVdBFPhUP7uCXReZAILFEUgteEDDSAtMqkWXPbYExNf6pXRYTr2aijbMmJKUVVZCNS53CZAkxo8YCUmTEWO8wbHVKH5ZBTnwRxwEaD30xdlYGM2xI3CNSGLh1K3hYBkGnMkZD

# Messenger / Instagram: las credenciales son POR NEGOCIO, no van acá.
# Se cargan con: PATCH /api/v1/businesses/{id}/channels
#   facebook_page_id, facebook_page_access_token, instagram_account_id

# Campañas proactivas (módulo gimnasios) — apagadas por defecto.
# Escribir fuera de la ventana de 24h de Meta exige plantillas APROBADAS en el
# panel de Meta. Sin nombres de plantilla configurados, el envío falla cerrado
# aunque CAMPAIGNS_ENABLED sea true.
CAMPAIGNS_ENABLED=false
CAMPAIGN_POLL_INTERVAL_SECONDS=3600
CAMPAIGN_EXPIRING_DAYS=7
CAMPAIGN_INACTIVE_DAYS=30
CAMPAIGN_DAILY_SEND_CAP=50
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_TEMPLATE_MEMBERSHIP_EXPIRING=
WHATSAPP_TEMPLATE_WINBACK=

# Email
EMAIL_PROVIDER=console
EMAIL_FROM=Agente Citas <noreply@agentecitas.com>
EMAIL_LANDING_BASE_URL=http://localhost:5174
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Rate limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=50

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Observability
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Security
JWT_SECRET_KEY=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
